# Postgres connection string. On Supabase use the "Transaction pooler" URI
# (Supabase -> Connect -> Transaction pooler, port 6543).
# If you use Vercel's Supabase integration, it sets POSTGRES_URL instead and
# the app picks that up, so you can leave DATABASE_URL out.
DATABASE_URL=postgres://postgres:password@localhost:5432/hilojack

# Password you hand out to league members to view the site.
SITE_PASSWORD=change-me

# Password for league managers (admin pages). Keep this one private.
ADMIN_PASSWORD=change-me-too

# Any long random string. Used to sign login cookies.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string
